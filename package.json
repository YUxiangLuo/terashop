{
  "name": "tera-headless",
  "type": "module",
  "private": true,
  "workspaces": ["storefront", "admin"],
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/bun": "1.4.0",
    "supabase": "2.116.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "storefront:dev": "bun scripts/frontend.ts storefront dev",
    "storefront:build": "bun scripts/frontend.ts storefront build",
    "storefront:check": "bun scripts/frontend.ts storefront check",
    "storefront:preview": "bun run --cwd storefront preview --host 0.0.0.0",
    "admin:dev": "bun scripts/frontend.ts admin dev",
    "admin:build": "bun scripts/frontend.ts admin build",
    "admin:check": "bun scripts/frontend.ts admin check",
    "admin:preview": "bun run --cwd admin preview",
    "setup": "bun scripts/setup.ts",
    "seed:media": "bun scripts/seed-media.ts",
    "start": "bun scripts/start.ts",
    "stop": "bunx supabase stop",
    "test": "bun scripts/test.ts --reset",
    "test:current": "bun scripts/test.ts",
    "test:unit": "bun test --parallel=1 tests/unit",
    "db:lint": "bun scripts/db-lint.ts",
    "docs:check": "bun scripts/docs-check.ts",
    "typecheck": "bunx tsc --noEmit",
    "types:generate": "bunx supabase gen types typescript --local --network-id tera-headless-loopback > types/database.ts",
    "types:check": "tmp=$(mktemp); trap 'rm -f \"$tmp\"' EXIT; bunx supabase gen types typescript --local --network-id tera-headless-loopback > \"$tmp\" && diff -u types/database.ts \"$tmp\""
  }
}
