# Storefront/Admin PUBLIC values: bundled into browser assets, never secrets.
# Leave both empty for automatic local Supabase discovery; set both for remote builds.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional public Admin MCP connection display (JSON: resource, issuer, scopes).
# No credentials. See admin/README.md; leave empty until deployment is configured.
PUBLIC_MCP_CONNECTION=

# Server-only managed-media browser allowlist, independent of payment origins.
# Empty denies all browser origins; programmatic MCP calls still work.
# Set exact Admin origins, e.g. http://127.0.0.1:5174 locally, HTTPS in production.
MEDIA_ALLOWED_ORIGINS=

# Local OAuth is disabled by default in supabase/config.toml.
# Rotate any previously committed credential before enabling Google OAuth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server-only payment configuration. Deploy this group with `supabase secrets set`,
# not the entire mixed-purpose file. Required in production: exact HTTPS origins.
# Local defaults below cover Vite dev/preview; adjust if their ports change.
PAYMENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# PayPal Orders v2 / Payments v2. Never expose PAYPAL_CLIENT_SECRET.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_LIVEMODE=false
# Leave empty to derive the official sandbox/live API host from PAYPAL_LIVEMODE.
PAYPAL_API_BASE=
# Required for PayPal Order creation: fixed URLs on implemented callback pages.
# The sample storefront DOES NOT implement these routes yet; placeholders only.
# Production requires HTTPS and matching PAYMENT_ALLOWED_ORIGINS.
PAYPAL_RETURN_URL=http://localhost:5173/checkout/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/paypal/cancel
PAYPAL_BRAND_NAME=Tera Store
