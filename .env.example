# Local OAuth is disabled by default in supabase/config.toml.
# Rotate any previously committed credential before enabling Google OAuth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Supabase Edge Function payment secrets (set with `supabase secrets set` in production).
PAYMENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PayPal Orders v2 / Payments v2. Never expose PAYPAL_CLIENT_SECRET.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_LIVEMODE=false
# Leave empty to derive the official sandbox/live API host from PAYPAL_LIVEMODE.
PAYPAL_API_BASE=
PAYPAL_RETURN_URL=http://localhost:3000/checkout/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/checkout/paypal/cancel
PAYPAL_BRAND_NAME=Tera Store

# Enable only after merchant Expanded Checkout approval and sandbox verification.
PAYPAL_CARDS_ENABLED=false
# Exact storefront hostname (no scheme, port or path); SDK v6 browser token binding.
PAYPAL_STOREFRONT_DOMAIN=localhost
