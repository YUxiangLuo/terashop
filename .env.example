# Local OAuth is disabled by default in supabase/config.toml.
# Rotate any previously committed credential before enabling Google OAuth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Supabase Edge Function payment secrets (set with `supabase secrets set` in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# During endpoint-secret rotation, optionally provide a comma-separated list.
STRIPE_WEBHOOK_SECRETS=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_LIVEMODE=false
# Leave empty in production. Test-mode local mocks may use localhost/127.0.0.1/host.docker.internal.
STRIPE_API_BASE=
STRIPE_HTTP_TIMEOUT_MS=10000
# `never` matches the current short inventory-reservation window. Enabling redirects
# requires a deliberate longer-lived/asynchronous reservation and cancellation policy.
STRIPE_ALLOW_REDIRECTS=never
PAYMENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PayPal Orders v2 / Payments v2. Never expose PAYPAL_CLIENT_SECRET.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_LIVEMODE=false
# Leave empty to derive the official sandbox/live API host from PAYPAL_LIVEMODE.
PAYPAL_API_BASE=
PAYPAL_RETURN_URL=http://localhost:3000/checkout/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/checkout/paypal/cancel
PAYPAL_BRAND_NAME=Tera Store
