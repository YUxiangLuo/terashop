# Local OAuth is disabled by default in supabase/config.toml.
# Rotate any previously committed credential before enabling Google OAuth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Supabase Edge Function payment secrets (set with `supabase secrets set` in production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# During endpoint-secret rotation, optionally provide a comma-separated list.
STRIPE_WEBHOOK_SECRETS=
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_LIVEMODE=false
PAYMENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
